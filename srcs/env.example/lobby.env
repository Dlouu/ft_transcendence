# User database URI
USER_DATABASE_URI=mysql+mysqldb://username:userpwd@database:3306/tablename

# Configuration URL for redis
REDIS_URL=redis://redis:6379/0

# S3 bucket name, should always exist and be the same in both API and lobby env
S3_BUCKET_NAME=s3-transcendence-bucket

# Flask secret
FLASK_SECRET_KEY=ANY_LONG_ENOUGH_STRING
