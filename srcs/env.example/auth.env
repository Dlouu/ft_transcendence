# Configuration URL for redis 
REDIS_URL=redis://redis:6379/0

# Password min and max len
AUTH_MIN_PASS_LENGTH=8
AUTH_MAX_PASS_LENGTH=64

# Username min and max len
AUTH_MIN_USERNAME_LENGTH=3
AUTH_MAX_USERNAME_LENGTH=24

# Refresh token expiration time (in second)
REFRESH_TOKEN_EXPIRATION=3600
# Refresh token expiration check (in second)
REFRESH_TOKEN_EXPIRATION_CHECK_DELAY=300
# Session token expiration (in second)
SESSION_TOKEN_EXPIRATION=300

# Timeout for database connection
DB_CONNECT_TIMEOUT=5
