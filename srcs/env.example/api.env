# AWSD access ID
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KY
# AWS secret access key
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
# AWS S3 bucket region
AWS_REGION=us-north-2
# AWS S3 bucket name
S3_BUCKET_NAME=awesome-bucket-name

# Secret to let the game service communicate with the API on a specific endpoint
# This variable should be manually set to any value you want for both api and game env file.
GAME_SECRET_KEY=GAME_SECRET_SHOULD_BE_LONG_AND_MODIFIED_FROM_TIME_TO_TIME

# URI to connect to the user database
USER_DATABASE_URI=mysql+mysqldb://username:userpwd@database:3306/tablename
# Configuration URL for redis 
REDIS_URL=redis://redis:6379/0169bb56422ae69201799a42d0354762fb2bc3521-137366f78e86285efee28340a0e8d149afe560a5

# Max image size allowed in MB
MAX_IMAGE_SIZE=2097152

# Life time of the token in the user's cookies
TOKEN_CACHE_LIFETIME=86400

# Default image, this dont need to be changed
DEFAULT_PROFILE_PICTURE=default_resources/default_profile_picture.png
DEFAULT_BACK_CARD=default_resources/default_back_card.png
